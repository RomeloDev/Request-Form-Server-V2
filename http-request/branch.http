@host = http://localhost:8000
@origin = http://localhost:3001
@xsrfToken = 

### 1. Start or refresh the CSRF session
GET {{host}}/sanctum/csrf-cookie
Accept: application/json
Origin: {{origin}}

### 2. Login with an existing verified local account
# @prompt email Enter your local account email
# @prompt password Enter your local account password
POST {{host}}/api/v1/login
Accept: application/json
Content-Type: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### 3. Confirm the login session
GET {{host}}/api/v1/profile
Accept: application/json
Origin: {{origin}}

### Create Branch API endpoint test
POST {{host}}/api/v1/add-branch
Accept: application/json
Content-Type: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

{
  "branch_code": "PRACTICE-001",
  "branch_name": "practice branch",
  "branch": "Honda Des, Inc."
}

### Edit branch
@branchId = 6

### Edit a KIA branch without changing its acronym
PUT {{host}}/api/v1/update-branch/{{branchId}}
Accept: application/json
Content-Type: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

{
  "branch_code": "KIA-PRACTICE-001",
  "branch_name": "updated practice branch",
  "branch": "Strong Moto Centrum, Inc."
}


### Delete Branch
DELETE {{host}}/api/v1/delete-branch/{{branchId}}
Accept: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}
