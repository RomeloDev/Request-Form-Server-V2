@host = http://localhost:8000
@origin = http://localhost:3001
@xsrfToken = 
@positionValue = Web Developer II

### 1. Start or refresh the CSRF session
GET {{host}}/sanctum/csrf-cookie
Accept: application/json
Origin: {{origin}}

### 2. Login with an existing verified local account
# @prompt email Enter your local account email
# @prompt password Enter your local account password
POST {{host}}/api/v1/login
Accept: application/json
Content-Type: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### 3. Confirm the login session
GET {{host}}/api/v1/profile
Accept: application/json
Origin: {{origin}}

### 4. Create a position
POST {{host}}/api/v1/create-position
Accept: application/json
Content-Type: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

{
  "value": "{{positionValue}}"
}

### 5. Test missing value
POST {{host}}/api/v1/create-position
Accept: application/json
Content-Type: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

{}

### 6. View positions
GET {{host}}/api/v1/positions
Accept: application/json

@positionId = 7

### Rename a position
PUT {{host}}/api/v1/update-position/{{positionId}}
Accept: application/json
Content-Type: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

{
  "label": "Software Developer"
}

### Delete a position
DELETE {{host}}/api/v1/delete-position/{{positionId}}
Accept: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}
