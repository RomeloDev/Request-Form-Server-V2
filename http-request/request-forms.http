### 9. Create a Stock Requisition with an attachment (multipart version)
# Expected: 201 Created
#
# Change the path after '<' to an existing local PDF. The file must be no
# larger than 5 MB. You can also use jpg, jpeg, png, webp, docx, or xlsx.
#
# Multipart field names such as items[0][quantity] become nested PHP arrays:
# items[0][quantity] -> $data['items'][0]['quantity']
# @prompt xsrfToken Paste the URL-decoded XSRF-TOKEN cookie value
POST {{host}}/api/v1/request-forms/stock-requisitions
Accept: application/json
Content-Type: multipart/form-data; boundary=RequestFormBoundary
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

--RequestFormBoundary
Content-Disposition: form-data; name="kind_of_request"

Office supplies
--RequestFormBoundary
Content-Disposition: form-data; name="form_data[purpose]"

Purchase supplies supported by an attached quotation.
--RequestFormBoundary
Content-Disposition: form-data; name="approved_by_ids[0]"

{{approvedById}}
--RequestFormBoundary
Content-Disposition: form-data; name="items[0][quantity]"

2
--RequestFormBoundary
Content-Disposition: form-data; name="items[0][unit]"

ream
--RequestFormBoundary
Content-Disposition: form-data; name="items[0][description]"

A4 bond paper
--RequestFormBoundary
Content-Disposition: form-data; name="items[0][unit_cost]"

100.20
--RequestFormBoundary
Content-Disposition: form-data; name="items[0][remarks]"

For Accounting
--RequestFormBoundary
Content-Disposition: form-data; name="attachments[0]"; filename="quotation.pdf"
Content-Type: application/pdf

< C:/replace/this/path/quotation.pdf
--RequestFormBoundary--


### 10. Missing Approved By: expected 422 Unprocessable Content
# @prompt xsrfToken Paste the URL-decoded XSRF-TOKEN cookie value
POST {{host}}/api/v1/request-forms/stock-requisitions
Accept: application/json
Content-Type: application/json
Origin: {{origin}}
X-XSRF-TOKEN: {{xsrfToken}}

{
  "kind_of_request": "Office supplies",
  "form_data": {
    "purpose": "Demonstrate a validation response."
  },
  "items": [
    {
      "quantity": "1",
      "unit": "piece",
      "description": "Test item",
      "unit_cost": "10.00",
      "remarks": null
    }
  ]
}


### Validation error response structure (example)
# {
#   "message": "The approved by ids field is required.",
#   "errors": {
#     "approved_by_ids": [
#       "The approved by ids field is required."
#     ]
#   }
# }


###############################################################################
# IMPORTANT SECURITY BOUNDARY
###############################################################################

# Do not send any of these fields:
# - requester_id or user_id
# - branch_id
# - request_code
# - status
# - currency
# - grand_total
# - items[*].line_number or items[*].line_total
# - approval_steps, level, step_type, approval_status, or acted_at
#
# Laravel derives or calculates all of them from the authenticated user,
# validated input, database routing assignments, and server-side arithmetic.
